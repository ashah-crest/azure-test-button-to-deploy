{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "11944829280691122203"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Base application name"
      }
    },
    "functionPackageUrl": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/ashah-crest/azure-test-button-to-deploy/main/host.zip",
      "metadata": {
        "description": "Public URL of the ZIP package containing the Java Function"
      }
    },
    "threatLists": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated GTI threat list categories (empty for all)"
      }
    },
    "lookBackDays": {
      "type": "string",
      "metadata": {
        "description": "Historical lookback period upto 7 days for initial sync (Default 7)"
      }
    },
    "verdicts": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated GTI verdict level(s) from \"VERDICT_BENIGN\",\"VERDICT_UNDETECTED\",\"VERDICT_SUSPICIOUS\",\"VERDICT_UNKNOWN\" & empty for all"
      }
    },
    "severities": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated GTI Severity level(s) from \"SEVERITY_NONE\", \"SEVERITY_LOW\", \"SEVERITY_MEDIUM\", \"SEVERITY_HIGH\", \"SEVERITY_UNKNOWN\" & empty for all"
      }
    },
    "threatScore": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Minimum GTI Threat Score"
      }
    },
    "gtiApiToken": {
      "type": "securestring",
      "metadata": {
        "description": "Google Threat Intelligence (GTI) API key"
      }
    },
    "timerSchedule": {
      "type": "string",
      "metadata": {
        "description": "Timer CRON expression passed via CLI"
      }
    },
    "currentUserObjectId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the Azure AD user executing the template to provide access to Key Vault"
      }
    },
    "clientID": {
      "type": "string",
      "metadata": {
        "description": "MS Defender Application Client ID"
      }
    },
    "clientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "MS Defender Application Client Secret"
      }
    },
    "applicationID": {
      "type": "string",
      "metadata": {
        "description": "MS Defender Application ID"
      }
    }
  },
  "variables": {
    "tenantId": "[tenant().tenantId]",
    "location": "[resourceGroup().location]",
    "storageTableContributor": "/providers/Microsoft.Authorization/roleDefinitions/0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3",
    "checkpointTableName": "ApiCheckpoints",
    "failedIOCsTableName": "FailedIOCs",
    "storageAccountName": "[toLower(format('{0}sa{1}', parameters('appName'), uniqueString(resourceGroup().id)))]",
    "functionAppName": "[format('{0}-func', parameters('appName'))]",
    "appInsightsName": "[format('{0}-ai', parameters('appName'))]",
    "keyVaultName": "[format('{0}-kv', parameters('appName'))]"
  },
  "resources": {
    "validateGtiParams": {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2020-10-01",
      "name": "validateGtiParams",
      "location": "[variables('location')]",
      "kind": "AzureCLI",
      "properties": {
        "azCliVersion": "2.52.0",
        "timeout": "PT5M",
        "cleanupPreference": "OnSuccess",
        "retentionInterval": "P1D",
        "forceUpdateTag": "validateGtiParamsTag",
        "scriptContent": "      # Split comma-separated strings\r\n      IFS=',' read -ra threatArr <<< \"${threatLists}\"\r\n      IFS=',' read -ra sevArr <<< \"${severities}\"\r\n      IFS=',' read -ra verArr <<< \"${verdicts}\"\r\n\r\n      invalid=()\r\n\r\n      # Helper function: exact match check\r\n      contains() {\r\n        local e\r\n        for e in \"${1[@]}\"; do\r\n          if [[ \"$e\" == \"$2\" ]]; then\r\n            return 0\r\n          fi\r\n        done\r\n        return 1\r\n      }\r\n\r\n      # Allowed lists\r\n      allowedT=(ransomware malicious-network-infrastructure malware threat-actor trending mobile osx linux iot cryptominer phishing first-stage-delivery-vectors vulnerability-weaponization infostealer)\r\n      allowedS=(SEVERITY_NONE SEVERITY_LOW SEVERITY_MEDIUM SEVERITY_HIGH SEVERITY_UNKNOWN)\r\n      allowedV=(VERDICT_BENIGN VERDICT_UNDETECTED VERDICT_SUSPICIOUS VERDICT_UNKNOWN)\r\n\r\n      # ===============================\r\n      # Validation loop for threatLists\r\n      # ===============================\r\n      for s in \"${threatArr[@]}\"; do\r\n        val=$(echo \"$s\" | xargs)          # trim spaces\r\n        val=${val//\\\"/}                    # remove double quotes\r\n        if [[ -n \"$val\" ]] && ! contains allowedT \"$val\"; then\r\n          invalid+=(\"threatLists:${val}\")\r\n        fi\r\n      done\r\n\r\n      # ===============================\r\n      # Validation loop for severities\r\n      # ===============================\r\n      for s in \"${sevArr[@]}\"; do\r\n        val=$(echo \"$s\" | xargs)\r\n        val=${val//\\\"/}\r\n        if [[ -n \"$val\" ]] && ! contains allowedS \"$val\"; then\r\n          invalid+=(\"severities:${val}\")\r\n        fi\r\n      done\r\n\r\n      # ===============================\r\n      # Validation loop for verdicts\r\n      # ===============================\r\n      for s in \"${verArr[@]}\"; do\r\n        val=$(echo \"$s\" | xargs)\r\n        val=${val//\\\"/}\r\n        if [[ -n \"$val\" ]] && ! contains allowedV \"$val\"; then\r\n          invalid+=(\"verdicts:${val}\")\r\n        fi\r\n      done\r\n\r\n      # ===============================\r\n      # Fail deployment if any invalid values\r\n      # ===============================\r\n      if [ ${#invalid[@]} -gt 0 ]; then\r\n        echo \"Invalid GTI parameters: ${invalid[*]}\"\r\n        exit 1\r\n      fi\r\n\r\n      echo \"All GTI parameters are valid\"\r\n    "
      }
    },
    "storageAccount": {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[variables('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "dependsOn": [
        "validateGtiParams"
      ]
    },
    "checkpointTable": {
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/default/{1}', variables('storageAccountName'), variables('checkpointTableName'))]",
      "dependsOn": [
        "storageAccount"
      ]
    },
    "failedIOCsTable": {
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/default/{1}', variables('storageAccountName'), variables('failedIOCsTableName'))]",
      "dependsOn": [
        "storageAccount"
      ]
    },
    "appInsights": {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[variables('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web"
      },
      "dependsOn": [
        "validateGtiParams"
      ]
    },
    "keyVault": {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-11-01",
      "name": "[variables('keyVaultName')]",
      "location": "[variables('location')]",
      "properties": {
        "tenantId": "[variables('tenantId')]",
        "sku": {
          "name": "standard",
          "family": "A"
        },
        "enableRbacAuthorization": false,
        "accessPolicies": []
      },
      "dependsOn": [
        "validateGtiParams"
      ]
    },
    "keyVaultSecret": {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'GtiApiToken')]",
      "properties": {
        "value": "[parameters('gtiApiToken')]"
      },
      "dependsOn": [
        "keyVault"
      ]
    },
    "hostingPlan": {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-plan', parameters('appName'))]",
      "location": "[variables('location')]",
      "kind": "linux",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {
        "reserved": true
      }
    },
    "functionApp": {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-11-01",
      "name": "[variables('functionAppName')]",
      "location": "[variables('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('appName')))]",
        "siteConfig": {
          "linuxFxVersion": "JAVA|17",
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[variables('storageAccountName')]"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "java"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};EndpointSuffix={1};AccountKey={2}', variables('storageAccountName'), environment().suffixes.storage, listKeys('storageAccount', '2025-01-01').keys[0].value)]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[parameters('functionPackageUrl')]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference('appInsights').InstrumentationKey]"
            },
            {
              "name": "LOOKBACK_DAYS",
              "value": "[parameters('lookBackDays')]"
            },
            {
              "name": "THREAT_LISTS",
              "value": "[parameters('threatLists')]"
            },
            {
              "name": "SEVERITY_LEVELS",
              "value": "[parameters('severities')]"
            },
            {
              "name": "VERDICT_LEVELS",
              "value": "[parameters('verdicts')]"
            },
            {
              "name": "GTI_SCORE",
              "value": "[parameters('threatScore')]"
            },
            {
              "name": "TIMER_SCHEDULE",
              "value": "[parameters('timerSchedule')]"
            },
            {
              "name": "KEYVAULT_URI",
              "value": "[reference('keyVault').vaultUri]"
            },
            {
              "name": "CHECKPOINT_TABLE_NAME",
              "value": "[variables('checkpointTableName')]"
            },
            {
              "name": "FAILED_IOC_TABLE_NAME",
              "value": "[variables('failedIOCsTableName')]"
            },
            {
              "name": "STORAGE_ACCOUNT_NAME",
              "value": "[variables('storageAccountName')]"
            },
            {
              "name": "CLIENT_ID",
              "value": "[parameters('clientID')]"
            },
            {
              "name": "CLIENT_SECRET",
              "value": "[parameters('clientSecret')]"
            },
            {
              "name": "APPLICATION_ID",
              "value": "[parameters('applicationID')]"
            }
          ]
        },
        "httpsOnly": true
      },
      "dependsOn": [
        "appInsights",
        "hostingPlan",
        "keyVault",
        "storageAccount",
        "validateGtiParams"
      ]
    },
    "keyVaultPolicy": {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'add')]",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[variables('tenantId')]",
            "objectId": "[reference('functionApp', '2024-11-01', 'full').identity.principalId]",
            "permissions": {
              "secrets": [
                "get",
                "list"
              ]
            }
          },
          {
            "tenantId": "[variables('tenantId')]",
            "objectId": "[parameters('currentUserObjectId')]",
            "permissions": {
              "secrets": [
                "get",
                "list",
                "set",
                "delete"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "functionApp",
        "keyVault"
      ]
    },
    "tableStorageRoleAssignment": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.Storage/storageAccounts/{0}', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.Web/sites', variables('functionAppName')), 'table-access')]",
      "properties": {
        "principalId": "[reference('functionApp', '2024-11-01', 'full').identity.principalId]",
        "roleDefinitionId": "[variables('storageTableContributor')]"
      },
      "dependsOn": [
        "functionApp",
        "storageAccount"
      ]
    }
  },
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "checkpointTable": {
      "type": "string",
      "value": "[variables('checkpointTableName')]"
    }
  }
}