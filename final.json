{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.36.177.2456",
      "templateHash": "8885229842765516960"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "metadata": {
        "description": "Base prefix for naming (no spaces)"
      }
    },
    "gtiApiKey": {
      "type": "securestring",
      "defaultValue": "8f3d691e940119a932e2a374c71d16dd31ad5c866410704b71df8a9a9455c670",
      "metadata": {
        "description": "Google Threat Intelligence (GTI) API Key"
      }
    },
    "threatLists": {
      "type": "string",
      "defaultValue": "ransomware",
      "metadata": {
        "description": "Comma-separated GTI threat list categories (empty for all)"
      }
    },
    "lookBackDays": {
      "type": "string",
      "defaultValue": "1",
      "metadata": {
        "description": "Historical lookback period upto 7 days for initial sync (Default 7)"
      }
    },
    "verdicts": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "(Optional) Comma-separated GTI Verdict level(s) from VERDICT_BENIGN, VERDICT_UNDETECTED, VERDICT_SUSPICIOUS, VERDICT_UNKNOWN & empty for all"
      }
    },
    "severities": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "(Optional) Comma-separated GTI Severity level(s) from SEVERITY_NONE, SEVERITY_LOW, SEVERITY_MEDIUM, SEVERITY_HIGH, SEVERITY_UNKNOWN & empty for all"
      }
    },
    "threatScore": {
      "type": "string",
      "defaultValue": "60",
      "metadata": {
        "description": "Minimum GTI Threat Score"
      }
    },
    "timerSchedule": {
      "type": "string",
      "defaultValue": "0 */5 * * * *",
      "metadata": {
        "description": "CRON expression for scheduling (default hourly)"
      }
    },
    "currentUserObjectId": {
      "type": "string",
      "defaultValue": "92c5470a-1222-4df9-8a67-f905b0e81f91",
      "metadata": {
        "description": "Object ID of deploying user for Key Vault access"
      }
    },
    "appClientID": {
      "type": "string",
      "defaultValue": "091029b1-c795-47c7-9e7a-b27dabf27e53",
      "metadata": {
        "description": "MS Defender Application Client ID"
      }
    },
    "appClientSecret": {
      "type": "securestring",
      "defaultValue": "qTI8Q~qyWv6eR-e9McobQvACFAFA-_cYB45SWaNc",
      "metadata": {
        "description": "MS Defender Application Client Secret"
      }
    },
    "appTenantId": {
      "type": "string",
      "defaultValue": "3adb963c-8e61-48e8-a06d-6dbb0dacea39",
      "metadata": {
        "description": "MS Defender Application Tenant ID"
      }
    }
  },
  "variables": {
    "functionPackageUrl": "https://raw.githubusercontent.com/ashah-crest/azure-test-button-to-deploy/main/host.zip",
    "tenantId": "[tenant().tenantId]",
    "location": "[resourceGroup().location]",
    "storageAccountName": "[toLower(format('{0}sa{1}', parameters('appName'), uniqueString(resourceGroup().id)))]",
    "deploymentContainerName": "[toLower(format('{0}-container', parameters('appName')))]",
    "hostingPlanName": "[format('{0}-plan', parameters('appName'))]",
    "functionAppName": "[format('{0}-func', parameters('appName'))]",
    "appInsightsName": "[format('{0}-ai', parameters('appName'))]",
    "keyVaultName": "[format('{0}-kv', parameters('appName'))]",
    "deploymentScriptName": "[format('{0}-ds', parameters('appName'))]",
    "checkpointTableName": "ApiCheckpoints",
    "failedIOCsTableName": "FailedIOCs",
    "storageTableContributor": "/providers/Microsoft.Authorization/roleDefinitions/0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3",
    "storageBlobDataOwnerRoleId": "b7e6dc6d-f1e8-4753-8033-0f276bb0955b",
    "storageBlobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe"
  },
  "resources": {
    "storageAccount::blobServices::deploymentContainer": {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('deploymentContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "storageAccount::blobServices"
      ]
    },
    "storageAccount::blobServices": {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "properties": {
        "deleteRetentionPolicy": {}
      },
      "dependsOn": [
        "storageAccount"
      ]
    },
    "scriptIdentity": {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-identity', parameters('appName'))]",
      "location": "[variables('location')]"
    },
    "roleAssignmentBlobDataOwner": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.Storage/storageAccounts/{0}', variables('storageAccountName'))]",
      "name": "[guid(subscription().id, resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))), 'Storage Blob Data Owner')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataOwnerRoleId'))]",
        "principalId": "[reference('scriptIdentity').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "scriptIdentity",
        "storageAccount"
      ]
    },
    "roleAssignmentBlob": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.Storage/storageAccounts/{0}', variables('storageAccountName'))]",
      "name": "[guid(subscription().id, resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))), 'Storage Blob Data Contributor')]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataContributorRoleId'))]",
        "principalId": "[reference('scriptIdentity').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "scriptIdentity",
        "storageAccount"
      ]
    },
    "roleAssignment": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))), 'contributor', resourceGroup().id)]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b24988ac-6180-42a0-ab88-20f7382dd24c')]",
        "principalId": "[reference('scriptIdentity').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "scriptIdentity"
      ]
    },
    "storageAccount": {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[variables('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "dnsEndpointType": "Standard",
        "minimumTlsVersion": "TLS1_2",
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Allow"
        },
        "publicNetworkAccess": "Enabled"
      }
    },
    "checkpointTable": {
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/default/{1}', variables('storageAccountName'), variables('checkpointTableName'))]",
      "dependsOn": [
        "storageAccount"
      ]
    },
    "failedIOCsTable": {
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/default/{1}', variables('storageAccountName'), variables('failedIOCsTableName'))]",
      "dependsOn": [
        "storageAccount"
      ]
    },
    "appInsights": {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[variables('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web"
      }
    },
    "keyVault": {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-11-01",
      "name": "[variables('keyVaultName')]",
      "location": "[variables('location')]",
      "properties": {
        "tenantId": "[variables('tenantId')]",
        "sku": {
          "name": "standard",
          "family": "A"
        },
        "enableRbacAuthorization": false,
        "accessPolicies": []
      }
    },
    "keyVaultSecret": {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'gti-api-token')]",
      "properties": {
        "value": "[parameters('gtiApiKey')]"
      },
      "dependsOn": [
        "keyVault"
      ]
    },
    "clientId": {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'app-client-id')]",
      "properties": {
        "value": "[parameters('appClientID')]"
      },
      "dependsOn": [
        "keyVault"
      ]
    },
    "clientSecret": {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'app-client-secret')]",
      "properties": {
        "value": "[parameters('appClientSecret')]"
      },
      "dependsOn": [
        "keyVault"
      ]
    },
    "applicationTenantId": {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'app-tenant-id')]",
      "properties": {
        "value": "[parameters('appTenantId')]"
      },
      "dependsOn": [
        "keyVault"
      ]
    },
    "hostingPlan": {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[variables('hostingPlanName')]",
      "location": "[variables('location')]",
      "kind": "linux",
      "sku": {
        "tier": "FlexConsumption",
        "name": "FC1"
      },
      "properties": {
        "reserved": true
      }
    },
    "zipUploadScript": {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}-zip-copy-ds', parameters('appName'))]",
      "location": "[variables('location')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))))]": {}
        }
      },
      "properties": {
        "azCliVersion": "2.59.0",
        "timeout": "PT10M",
        "retentionInterval": "P1D",
        "environmentVariables": [
          {
            "name": "ZIP_URL",
            "value": "[variables('functionPackageUrl')]"
          },
          {
            "name": "STORAGE_ACCOUNT",
            "value": "[variables('storageAccountName')]"
          },
          {
            "name": "CONTAINER_NAME",
            "value": "[variables('deploymentContainerName')]"
          },
          {
            "name": "DEST_BLOB_NAME",
            "value": "gti.zip"
          }
        ],
        "scriptContent": "      # Start the server-side copy from Public URL to Azure Blob\r\n      echo \"Starting copy from $ZIP_URL...\"\r\n      az storage blob copy start \\\r\n        --account-name $STORAGE_ACCOUNT \\\r\n        --destination-container $CONTAINER_NAME \\\r\n        --destination-blob $DEST_BLOB_NAME \\\r\n        --source-uri $ZIP_URL \\\r\n        --auth-mode login\r\n\r\n      # Give Azure a moment to initialize the copy metadata\r\n      sleep 5\r\n\r\n      # Poll for completion\r\n      while true; do\r\n        status=$(az storage blob show \\\r\n          --account-name $STORAGE_ACCOUNT \\\r\n          --container-name $CONTAINER_NAME \\\r\n          --name $DEST_BLOB_NAME \\\r\n          --query \"properties.copy.status\" -o tsv \\\r\n          --auth-mode login)\r\n        \r\n        echo \"Current Status: $status\"\r\n\r\n        if [ \"$status\" == \"success\" ]; then\r\n          echo \"Copy completed successfully.\"\r\n          break\r\n        elif [ \"$status\" == \"failed\" ] || [ \"$status\" == \"aborted\" ]; then\r\n          echo \"Error: Copy ended with terminal state: $status\"\r\n          exit 1\r\n        fi\r\n        \r\n        # Wait before checking again\r\n        sleep 5\r\n      done\r\n    "
      },
      "dependsOn": [
        "roleAssignment",
        "scriptIdentity",
        "storageAccount"
      ]
    },
    "functionApp": {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-11-01",
      "name": "[variables('functionAppName')]",
      "location": "[variables('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "functionAppConfig": {
          "runtime": {
            "name": "java",
            "version": "17"
          },
          "scaleAndConcurrency": {
            "instanceMemoryMB": 2048,
            "maximumInstanceCount": 3
          },
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[format('{0}{1}', reference('storageAccount').primaryEndpoints.blob, variables('deploymentContainerName'))]",
              "authentication": {
                "type": "UserAssignedIdentity",
                "userAssignedIdentityResourceId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName')))]"
              }
            }
          }
        },
        "siteConfig": {
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[variables('storageAccountName')]"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};EndpointSuffix={1};AccountKey={2}', variables('storageAccountName'), environment().suffixes.storage, listKeys('storageAccount', '2025-01-01').keys[0].value)]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference('appInsights').InstrumentationKey]"
            },
            {
              "name": "LOOKBACK_DAYS",
              "value": "[parameters('lookBackDays')]"
            },
            {
              "name": "THREAT_LISTS",
              "value": "[parameters('threatLists')]"
            },
            {
              "name": "SEVERITY_LEVELS",
              "value": "[parameters('severities')]"
            },
            {
              "name": "VERDICT_LEVELS",
              "value": "[parameters('verdicts')]"
            },
            {
              "name": "GTI_SCORE",
              "value": "[parameters('threatScore')]"
            },
            {
              "name": "TIMER_SCHEDULE",
              "value": "[parameters('timerSchedule')]"
            },
            {
              "name": "KEYVAULT_URI",
              "value": "[reference('keyVault').vaultUri]"
            },
            {
              "name": "CHECKPOINT_TABLE_NAME",
              "value": "[variables('checkpointTableName')]"
            },
            {
              "name": "FAILED_IOC_TABLE_NAME",
              "value": "[variables('failedIOCsTableName')]"
            },
            {
              "name": "STORAGE_ACCOUNT_NAME",
              "value": "[variables('storageAccountName')]"
            },
            {
              "name": "CLIENT_ID",
              "value": "[parameters('appClientID')]"
            },
            {
              "name": "CLIENT_SECRET",
              "value": "[parameters('appClientSecret')]"
            },
            {
              "name": "APPLICATION_ID",
              "value": "[parameters('appTenantId')]"
            }
          ]
        },
        "httpsOnly": true
      },
      "dependsOn": [
        "appInsights",
        "hostingPlan",
        "keyVault",
        "scriptIdentity",
        "storageAccount",
        "zipUploadScript"
      ]
    },
    "functionAppName_OneDeploy": {
      "type": "Microsoft.Web/sites/extensions",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}/onedeploy', variables('functionAppName'))]",
      "location": "[variables('location')]",
      "properties": {
        "packageUri": "[variables('functionPackageUrl')]",
        "remoteBuild": false
      }
    },
    "keyVaultPolicy": {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'add')]",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[variables('tenantId')]",
            "objectId": "[reference('functionApp', '2024-11-01', 'full').identity.principalId]",
            "permissions": {
              "secrets": [
                "get",
                "list"
              ]
            }
          },
          {
            "tenantId": "[variables('tenantId')]",
            "objectId": "[parameters('currentUserObjectId')]",
            "permissions": {
              "secrets": [
                "get",
                "list",
                "set",
                "delete"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "functionApp",
        "keyVault"
      ]
    },
    "tableStorageRoleAssignment": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.Storage/storageAccounts/{0}', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.Web/sites', variables('functionAppName')), 'table-access')]",
      "properties": {
        "principalId": "[reference('functionApp', '2024-11-01', 'full').identity.principalId]",
        "roleDefinitionId": "[variables('storageTableContributor')]"
      },
      "dependsOn": [
        "functionApp",
        "storageAccount"
      ]
    }
  },
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[variables('functionAppName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "checkpointTable": {
      "type": "string",
      "value": "[variables('checkpointTableName')]"
    }
  }
}