{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.40.2.10011",
      "templateHash": "6805871502488307613"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Base application name"
      }
    },
    "functionPackageUrl": {
      "type": "string",
      "defaultValue": "https://github.com/ashah-crest/azure-test-button-to-deploy/blob/main/host.zip",
      "metadata": {
        "description": "Public URL of the ZIP package containing the Java Function"
      }
    },
    "threatLists": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated GTI threat list categories (empty for all)"
      }
    },
    "lookBackDays": {
      "type": "string",
      "defaultValue": "7",
      "metadata": {
        "description": "Historical lookback period in days for initial sync (max 7)"
      }
    },
    "verdicts": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated GTI verdict level(s) from \"VERDICT_BENIGN\",\"VERDICT_UNDETECTED\",\"VERDICT_SUSPICIOUS\",\"VERDICT_UNKNOWN\" & empty for all"
      }
    },
    "severities": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated GTI Severity level(s) from \"SEVERITY_NONE\", \"SEVERITY_LOW\", \"SEVERITY_MEDIUM\", \"SEVERITY_HIGH\", \"SEVERITY_UNKNOWN\" & empty for all"
      }
    },
    "threatScore": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Minimum GTI Threat Score"
      }
    },
    "gtiApiToken": {
      "type": "securestring",
      "metadata": {
        "description": "Google Threat Intelligence (GTI) API key"
      }
    },
    "timerSchedule": {
      "type": "string",
      "metadata": {
        "description": "Timer CRON expression passed via CLI"
      }
    },
    "currentUserObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object ID of the Azure AD user executing the template to provide access to Key Vault"
      }
    },
    "checkpointTableName": {
      "type": "string",
      "defaultValue": "ApiCheckpoints",
      "metadata": {
        "description": "Checkpoint table name"
      }
    }
  },
  "variables": {
    "storageAccountName": "[toLower(format('{0}sa{1}', parameters('appName'), uniqueString(resourceGroup().id)))]",
    "functionAppName": "[format('{0}-func', parameters('appName'))]",
    "appInsightsName": "[format('{0}-ai', parameters('appName'))]",
    "keyVaultName": "[format('{0}-kv', parameters('appName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2025-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}/default/{1}', variables('storageAccountName'), parameters('checkpointTableName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-11-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "name": "standard",
          "family": "A"
        },
        "enableRbacAuthorization": false,
        "accessPolicies": []
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'GtiApiToken')]",
      "properties": {
        "value": "[parameters('gtiApiToken')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-plan', parameters('appName'))]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-11-01",
      "name": "[variables('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('appName')))]",
        "siteConfig": {
          "linuxFxVersion": "JAVA|17",
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[variables('storageAccountName')]"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "java"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "AzureWebJobsStorage",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};EndpointSuffix={1};AccountKey={2}', variables('storageAccountName'), environment().suffixes.storage, listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2025-01-01').keys[0].value)]"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "[parameters('functionPackageUrl')]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').InstrumentationKey]"
            },
            {
              "name": "LOOKBACK_DAYS",
              "value": "[parameters('lookBackDays')]"
            },
            {
              "name": "THREAT_LISTS",
              "value": "[parameters('threatLists')]"
            },
            {
              "name": "SEVERITY_LEVELS",
              "value": "[parameters('severities')]"
            },
            {
              "name": "VERDICT_LEVELS",
              "value": "[parameters('verdicts')]"
            },
            {
              "name": "GTI_SCORE",
              "value": "[parameters('threatScore')]"
            },
            {
              "name": "TIMER_SCHEDULE",
              "value": "[parameters('timerSchedule')]"
            },
            {
              "name": "KEYVAULT_URI",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2024-11-01').vaultUri]"
            },
            {
              "name": "CHECKPOINT_TABLE_NAME",
              "value": "[parameters('checkpointTableName')]"
            },
            {
              "name": "STORAGE_ACCOUNT_NAME",
              "value": "[variables('storageAccountName')]"
            }
          ]
        },
        "httpsOnly": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('appName')))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/accessPolicies",
      "apiVersion": "2024-11-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), 'add')]",
      "properties": {
        "accessPolicies": [
          {
            "tenantId": "[subscription().tenantId]",
            "objectId": "[reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2024-11-01', 'full').identity.principalId]",
            "permissions": {
              "secrets": [
                "get",
                "list"
              ]
            }
          },
          {
            "tenantId": "[subscription().tenantId]",
            "objectId": "[parameters('currentUserObjectId')]",
            "permissions": {
              "secrets": [
                "get",
                "list",
                "set",
                "delete"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.Web/sites', variables('functionAppName')), 'table-access')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('functionAppName')), '2024-11-01', 'full').identity.principalId]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    }
  ],
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "checkpointTable": {
      "type": "string",
      "value": "[parameters('checkpointTableName')]"
    }
  }
}